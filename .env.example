# ==============================================================================
# Environment Configuration Template
# Copy this file to .env and adjust the values for your server environment:
#   cp .env.example .env
# ==============================================================================

# Django Secret Key (Generate a new secure key for production)
SECRET_KEY=django-insecure-replace-this-with-a-real-secret-key-in-production

# Debug Mode (MUST be False in production)
DEBUG=False

# Allowed Hosts (comma-separated domains and IPs)
ALLOWED_HOSTS=localhost,127.0.0.1,your_domain.com,your_server_ip

# CORS Settings
CORS_ALLOW_ALL_ORIGINS=True

# Email Backend (console for testing, smtp for production)
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend

# eSewa Payment Integration
ESEWA_PRODUCT_CODE=EPAYTEST
ESEWA_SECRET_KEY=8gBm/:&EnhH.1/q
ESEWA_PAYMENT_URL=https://rc-epay.esewa.com.np/api/epay/main/v2/form
ESEWA_STATUS_URL=https://rc.esewa.com.np/api/epay/transaction/status/
ESEWA_SUCCESS_URL=http://localhost:8000/api/payments/esewa/success/
ESEWA_FAILURE_URL=http://localhost:8000/api/payments/esewa/failure/

# Gunicorn Settings (optional overrides)
GUNICORN_BIND=127.0.0.1:8000
GUNICORN_WORKERS=3
GUNICORN_LOG_LEVEL=info
